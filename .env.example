# ---- 在线模式（LLM_API_KEY 留空 = 离线模式：LLM 节点降级为规则 / 模板）
# 示例：硅基流动（OpenAI 兼容）。复制本文件为 .env 后填入自己的 key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
MODEL_SMALL=Qwen/Qwen3.5-9B               # 路由 / 子 Agent / 回答
MODEL_LARGE=Qwen/Qwen3.6-35B-A3B          # Planner
DISABLE_THINKING=1                        # 关闭 Qwen 思考模式（平台不支持该参数时设为 0）

# ---- 可选的真实模型（需要下载权重）
# EMBEDDER=qwen          # Qwen3-Embedding-0.6B
# VISION=bioclip         # BioCLIP 2
# GUARD_MODELS=1         # Prompt Guard 2 + Qwen3Guard

# ---- 评测 / 运行
FIXTURE_MODE=1            # 1 = 天气潮汐读固定数据；0 = 调 Open-Meteo
FROZEN_TODAY=2026-10-10
APP_ENV=dev               # prod 时不返回调试信息、关闭 /v1/dev-token
API_SECRET=change-me
RATE_PER_MIN=20
